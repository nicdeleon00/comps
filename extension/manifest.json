{
  "manifest_version": 3,
  "name": "Comps for Marketplace",
  "version": "2.0.0",
  "description": "Puts Comps market prices on every Pokémon card listing on Facebook Marketplace, finds the deals for you with one click, and shares them on Comps.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Comps for Marketplace",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://nicdeleon00.github.io/*",
    "https://*.supabase.co/*",
    "https://www.facebook.com/*",
    "https://web.facebook.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "js": [
        "marketplace.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://nicdeleon00.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
